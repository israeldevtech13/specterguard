<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SpecterGuard - Detecte anúncios fraudulentos</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: linear-gradient(135deg, #0a0f1c 0%, #1a1a3e 50%, #0d1117 100%);
            min-height: 100vh;
            padding: 20px;
        }

        .container {
            max-width: 800px;
            margin: 0 auto;
            background: white;
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            overflow: hidden;
        }

        header {
            background: linear-gradient(135deg, #0a0f1c 0%, #1a1a3e 100%);
            color: white;
            padding: 30px;
            text-align: center;
        }

        header h1 {
            font-size: 2em;
            margin-bottom: 10px;
            letter-spacing: 2px;
        }

        header p {
            opacity: 0.9;
            font-size: 0.9em;
        }

        .input-section {
            padding: 30px;
        }

        label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
            color: #333;
            margin-top: 20px;
        }

        label:first-of-type {
            margin-top: 0;
        }

        textarea, input {
            width: 100%;
            padding: 12px;
            border: 2px solid #e0e0e0;
            border-radius: 10px;
            font-size: 14px;
            transition: border-color 0.3s;
            font-family: inherit;
        }

        textarea:focus, input:focus {
            outline: none;
            border-color: #4a4a8a;
        }

        textarea {
            resize: vertical;
        }

        button {
            background: linear-gradient(135deg, #0a0f1c 0%, #1a1a3e 100%);
            color: white;
            border: none;
            padding: 14px 30px;
            border-radius: 10px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: transform 0.2s, box-shadow 0.2s;
            margin-top: 25px;
            width: 100%;
        }

        button:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 20px rgba(26, 26, 62, 0.4);
        }

        .resultado {
            margin: 0 30px 30px 30px;
            padding: 20px;
            border-radius: 15px;
            animation: slideIn 0.3s ease-out;
        }

        @keyframes slideIn {
            from {
                opacity: 0;
                transform: translateY(-20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .resultado.risco-alto {
            background: #fee;
            border-left: 5px solid #e74c3c;
        }

        .resultado.risco-medio {
            background: #fff3cd;
            border-left: 5px solid #f39c12;
        }

        .resultado.risco-baixo {
            background: #d4edda;
            border-left: 5px solid #27ae60;
        }

        .resultado h3 {
            margin-bottom: 15px;
        }

        .resultado .score {
            font-size: 1.5em;
            font-weight: bold;
            margin: 10px 0;
        }

        .resultado .evidencias {
            margin-top: 15px;
            padding-left: 20px;
        }

        .resultado .evidencias li {
            margin: 8px 0;
        }

        .exemplos {
            padding: 0 30px 30px 30px;
        }

        .exemplos h3 {
            margin-bottom: 15px;
            color: #333;
        }

        .exemplo-btn {
            background: #f0f0f0;
            color: #333;
            margin-right: 10px;
            margin-top: 10px;
            width: auto;
            display: inline-block;
            padding: 8px 16px;
            font-size: 14px;
        }

        .exemplo-btn:hover {
            background: #e0e0e0;
            transform: none;
            box-shadow: none;
        }

        .stats {
            padding: 20px 30px 30px 30px;
            border-top: 2px solid #f0f0f0;
            background: #fafafa;
        }

        .stats h3 {
            margin-bottom: 10px;
            color: #555;
        }

        #totalGolpes {
            font-size: 1.5em;
            color: #e74c3c;
        }

        .hidden {
            display: none;
        }

        @media (max-width: 600px) {
            .input-section, .exemplos, .stats {
                padding: 20px;
            }
            header h1 {
                font-size: 1.5em;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <h1>👻 SpecterGuard</h1>
            <p>Proteja-se contra anúncios falsos do Kwai, links suspeitos e números fraudulentos</p>
        </header>

        <div class="input-section">
            <label for="anuncio">📝 Cole o texto do anúncio:</label>
            <textarea id="anuncio" rows="5" placeholder="Ex: 🚨 URGENTE! Ganhe R$ 500 por dia no Kwai! Código: 123456..."></textarea>

            <label for="link">🔗 Link suspeito (opcional):</label>
            <input type="text" id="link" placeholder="https://bit.ly/exemplo">

            <label for="whatsapp">📱 WhatsApp (opcional):</label>
            <input type="text" id="whatsapp" placeholder="(11) 91234-5678">

            <button id="analisarBtn">🔍 Analisar com SpecterGuard</button>
        </div>

        <div id="resultado" class="resultado hidden"></div>

        <div class="exemplos">
            <h3>📋 Teste com exemplos:</h3>
            <button class="exemplo-btn" data-exemplo="1">Golpe Kwai</button>
            <button class="exemplo-btn" data-exemplo="2">Falso Prêmio</button>
            <button class="exemplo-btn" data-exemplo="3">Anúncio Ok</button>
        </div>

        <div class="stats">
            <h3>📊 SpecterGuard em ação:</h3>
            <p>🛡️ Ameaças neutralizadas: <strong id="totalGolpes">0</strong></p>
        </div>
    </div>

    <script>
        // SpecterGuard - Detector de Anúncios Fraudulentos
        // Versão 1.0 - Nome exclusivo verificado

        const padroesFraude = {
            financeiro: [
                { regex: /R\$\s*\d{2,4}\s*por\s*(dia|hora|semana)/i, peso: 3, descricao: "Promessa de ganho fácil" },
                { regex: /ganhe\s*R\$\s*\d+/i, peso: 3, descricao: "Promessa de valor específico" },
                { regex: /renda\s*(extra|passiva|fácil)/i, peso: 3, descricao: "Renda extra milagrosa" },
                { regex: /(milagroso|secreto|revolucionário|infalível)/i, peso: 4, descricao: "Termo sensacionalista" }
            ],
            urgencia: [
                { regex: /urgente|agora|já|imediatamente/i, peso: 2, descricao: "Gatilho de urgência" },
                { regex: /(últimas|limitado|exclusivo|imperdível)/i, peso: 2, descricao: "Falsa escassez" },
                { regex: /(vagas?|oportunidade)\s+(limitadas?|acabando)/i, peso: 3, descricao: "Pressão com vagas" }
            ],
            kwai: [
                { regex: /código\s*[:\s]*(\d{6,10})/i, peso: 8, descricao: "🚨 PEDIDO DE CÓDIGO - GOLPE CRÍTICO" },
                { regex: /(kwai|kuaishou).*(código|code|convite)/i, peso: 6, descricao: "Golpe de convite Kwai" },
                { regex: /(seguir|curtir|compartilhar)\s*e\s*(ganhar|receber)/i, peso: 4, descricao: "Engajamento falso" }
            ],
            contato: [
                { regex: /(whatsapp|zap|whats|telegram|wpp)/i, peso: 2, descricao: "Redirecionamento para app de mensagem" }
            ],
            encurtadores: ['bit.ly', 'tinyurl.com', 'goo.gl', 'ow.ly', 'shorturl.at', 'is.gd', 'cutt.ly']
        };

        const palavrasBloqueadas = [
            'tigrinho', 'fortune tiger', 'betano', 'aposta', 'cassino',
            'criptomoeda', 'bitcoin', 'pirâmide', 'fiz 5000'
        ];

        function detectarSpecterGuard(texto, link = '', whatsapp = '') {
            let score = 0;
            let evidencias = [];
            
            for (const categoria in padroesFraude) {
                if (categoria === 'encurtadores') continue;
                padroesFraude[categoria].forEach(p => {
                    if (p.regex.test(texto)) {
                        score += p.peso;
                        evidencias.push(p.descricao);
                    }
                });
            }
            
            palavrasBloqueadas.forEach(palavra => {
                if (texto.toLowerCase().includes(palavra)) {
                    score += 5;
                    evidencias.push(`🚨 Palavra bloqueada: "${palavra}"`);
                }
            });
            
            if (link) {
                const encurtado = padroesFraude.encurtadores.some(e => link.includes(e));
                if (encurtado) {
                    score += 4;
                    evidencias.push("Link encurtado detectado");
                }
                if (/kwai|kuaishou/i.test(link) && !/kwai\.com|kuaishou\.com/.test(link)) {
                    score += 6;
                    evidencias.push("🚨 DOMÍNIO FALSO imitando Kwai");
                }
            }
            
            if (whatsapp) {
                const num = whatsapp.replace(/\D/g, '');
                if (num.length >= 10) {
                    const ddds = ['11', '21', '61', '31', '41'];
                    if (ddds.includes(num.substring(0, 2))) {
                        score += 2;
                        evidencias.push(`WhatsApp DDD ${num.substring(0, 2)} (comum em golpes)`);
                    }
                }
            }
            
            if ((/whatsapp|zap/i.test(texto) || whatsapp) && link && padroesFraude.encurtadores.some(e => link.includes(e))) {
                score += 3;
                evidencias.push("🔴 Combinação: WhatsApp + link encurtado");
            }
            
            let risco, cor, recomendacao;
            if (score >= 8) {
                risco = "ALTO";
                cor = "risco-alto";
                recomendacao = "🚨 GOLPE CONFIRMADO! Não clique, não compartilhe, não envie dinheiro.";
            } else if (score >= 4) {
                risco = "MÉDIO";
                cor = "risco-medio";
                recomendacao = "⚠️ MUITO SUSPEITO! Verifique fontes oficiais antes de qualquer ação.";
            } else {
                risco = "BAIXO";
                cor = "risco-baixo";
                recomendacao = "✅ Parece legítimo, mas mantenha atenção.";
            }
            
            return { score, risco, cor, recomendacao, evidencias: [...new Set(evidencias)] };
        }

        function atualizarStats() {
            let total = localStorage.getItem('specterGuardTotal') || 0;
            document.getElementById('totalGolpes').textContent = total;
        }

        function incrementarStats(risco) {
            if (risco === 'ALTO') {
                let total = parseInt(localStorage.getItem('specterGuardTotal') || 0);
                total++;
                localStorage.setItem('specterGuardTotal', total);
                atualizarStats();
            }
        }

        function exibirResultado(r) {
            const div = document.getElementById('resultado');
            div.className = `resultado ${r.cor}`;
            div.classList.remove('hidden');
            
            const emoji = r.score >= 8 ? '🔴' : (r.score >= 4 ? '🟡' : '🟢');
            
            let evidenciasHtml = '';
            if (r.evidencias.length > 0) {
                evidenciasHtml = `<h4>🚩 Evidências:</h4><ul>${r.evidencias.map(e => `<li>⚠️ ${e}</li>`).join('')}</ul>`;
            } else {
                evidenciasHtml = '<p>✅ Nenhum padrão suspeito detectado.</p>';
            }
            
            div.innerHTML = `
                <h3>${emoji} Resultado SpecterGuard</h3>
                <div class="score">Risco: ${r.risco} (${r.score}/20)</div>
                ${evidenciasHtml}
                <div style="margin-top:20px;padding:10px;background:rgba(0,0,0,0.05);border-radius:8px;">
                    <strong>💡 Recomendação:</strong> ${r.recomendacao}
                </div>
            `;
            
            div.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            incrementarStats(r.risco);
        }

        function carregarExemplo(tipo) {
            const exemplos = {
                1: { texto: "🚨 URGENTE! Ganhe R$ 500 por dia no Kwai! Código: 123456789. Chama no zap: (11) 91234-5678", link: "bit.ly/ganhe-agora", whatsapp: "5511912345678" },
                2: { texto: "PARABÉNS! Você ganhou um iPhone! Pague apenas o frete R$ 89,90. Últimas unidades!", link: "tinyurl.com/premio", whatsapp: "" },
                3: { texto: "Promoção válida: 20% off em toda loja. Confira nosso site oficial.", link: "https://www.lojaoficial.com.br", whatsapp: "" }
            };
            
            const ex = exemplos[tipo];
            if (ex) {
                document.getElementById('anuncio').value = ex.texto;
                document.getElementById('link').value = ex.link;
                document.getElementById('whatsapp').value = ex.whatsapp;
            }
        }

        document.getElementById('analisarBtn').addEventListener('click', () => {
            const texto = document.getElementById('anuncio').value.trim();
            if (!texto) {
                alert('Cole o texto do anúncio para análise.');
                return;
            }
            const resultado = detectarSpecterGuard(
                texto,
                document.getElementById('link').value.trim(),
                document.getElementById('whatsapp').value.trim()
            );
            exibirResultado(resultado);
        });

        document.querySelectorAll('.exemplo-btn').forEach(btn => {
            btn.addEventListener('click', () => carregarExemplo(parseInt(btn.getAttribute('data-exemplo'))));
        });

        atualizarStats();
        console.log('👻 SpecterGuard pronto para proteger você!');
    </script>
</body>
</html>
